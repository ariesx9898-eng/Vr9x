}

R_EVENTS = {
    "Cast_Fireball": {"Release": 0.30}, "Cast_Fireball_Release": {"Release": 0.04},
    "Cast_FlameWave": {"Release": 0.42}, "Cast_Inferno": {"Release": 0.90},
    "Cast_WaterBullet": {"Release": 0.22}, "Cast_WaterDragon": {"Release": 0.75}, "Cast_Flood": {"Release": 0.70},
    "Cast_StoneCannon": {"Release": 0.35}, "Cast_StoneCannon_Release": {"Release": 0.04},
    "Cast_EarthWall": {"Release": 0.40}, "Cast_EarthSpikes": {"Release": 0.40},
    "Cast_WindBlade": {"Release": 0.25}, "Cast_Tornado": {"Release": 0.55}, "Cast_WindBurst": {"Release": 0.12},
    "StoneCannon_Charge": {"Release": 0.35}, "StoneCannon_Release": {"Release": 0.04},
