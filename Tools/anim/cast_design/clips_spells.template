def still_hold(P0, period, side="R", fingers=3.0, wrist=2.0):
    """Orsted holding a spell: almost still, a slow finger wave and a slight turn of the wrist."""
    def fn(t):
        w = TAU * (t % period) / period
        P = dict(P0)
        for i, k in enumerate(("ci", "cm", "cr", "cp")):
            P[side + "_" + k] = P0.get(side + "_" + k, 0.0) + fingers * _wave(w, -0.8 * i)
        P[side + "_roll"] = P0.get(side + "_roll", 0.0) + wrist * math.sin(w)
        P["hair_lag"] = P0.get("hair_lag", 0.0) + 0.3 * math.sin(w)
        return P
    return fn


# ============================================================================================================ builders
def _oneshots(table, stance, keyed):
    out = {}
    for name, (duration, keys) in table.items():
        full = [(t, _m(stance, d)) for t, d in keys]
        out[name] = (duration, False, (lambda t, full=full: keyed(full, t, stance)))
    return out


def rudeus(C):
    """Rudeus's clips and events. C is the clips module (its COMBAT stance and keyed interpolation)."""
    clips = _oneshots(R_KEYS, C.COMBAT, C.keyed)
    clips["Cast_Fireball_Hold"] = (F(30), True, fireball_hold(_m(C.COMBAT, FB_HOLD), F(30)))
    clips["Cast_StoneCannon_Hold"] = (F(30), True, stone_hold(_m(C.COMBAT, SCS_HOLD), F(30), tremor=0.9, press=4.0))
    clips["StoneCannon_Hold"] = (F(30), True, stone_hold(_m(C.COMBAT, SC_HOLD), F(30), tremor=1.5, press=5.0))
    clips["Quagmire_Hold"] = (F(30), True, quagmire_hold(_m(C.COMBAT, QG_HOLD), F(30)))
    return clips, {k: dict(v) for k, v in R_EVENTS.items()}


def orsted(guard, keyed):
    """Orsted's own element casts, Disturb Magic and Dragon Crush (his guard in and out)."""
    clips = _oneshots(O_KEYS, guard, keyed)
    clips["Cast_Fireball_Hold"] = (F(18), True, still_hold(_m(guard, OFB_HOLD), F(18)))
    clips["Cast_StoneCannon_Hold"] = (F(18), True, still_hold(_m(guard, OSC_HOLD), F(18), fingers=2.0, wrist=1.5))
    return clips, {k: dict(v) for k, v in O_EVENTS.items()}
