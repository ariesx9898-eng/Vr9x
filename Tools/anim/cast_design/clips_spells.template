def fireball_hold(P0, period):
    """The fingers roll the sphere inward (a wave from the index to the little finger), the palm turns under it and the
    left hand circles over it."""
    def fn(t):
        w = TAU * (t % period) / period
        P = dict(P0)
        for i, k in enumerate(("R_ci", "R_cm", "R_cr", "R_cp")):
            P[k] = P0.get(k, 0.0) + 8.0 * _wave(w, -0.9 * i)
        for i, k in enumerate(("L_ci", "L_cm", "L_cr", "L_cp")):
            P[k] = P0.get(k, 0.0) + 5.0 * _wave(w, 0.9 * i + 1.0)
        P["R_roll"] = P0.get("R_roll", 0.0) + 5.0 * math.sin(w)
        P["R_wyaw"] = P0.get("R_wyaw", 0.0) + 3.0 * math.sin(2.0 * w)
        P["L_fwd"] = P0["L_fwd"] + 3.0 * (math.cos(w) - 1.0)
        P["L_lower"] = P0["L_lower"] + 2.5 * math.sin(w)
        P["L_roll"] = P0.get("L_roll", 0.0) - 4.0 * math.sin(w)
        P["sp_pitch"] = P0["sp_pitch"] + 0.8 * math.sin(w)
        P["pel_z"] = P0["pel_z"] + 0.004 * math.sin(2.0 * w)
        P["hair_lag"] = P0.get("hair_lag", 0.0) + 0.8 * math.sin(2.0 * w)
        P["coat_flare"] = P0.get("coat_flare", 0.0) + 0.8 * math.sin(w)
        return P
    return fn


def stone_hold(P0, period, tremor=1.2, press=5.0):
    """Compression: the fingers tighten in pulses, the hand trembles with the spinning slug (4-5 Hz, small), the wrist
    turns the core. The left hand's grip pulses with it when it braces the forearm."""
    def fn(t):
        w = TAU * (t % period) / period
        P = dict(P0)
        P["R_curl"] = P0["R_curl"] + press * math.sin(2.0 * w)
        P["R_elbow"] = P0["R_elbow"] + tremor * math.sin(10.0 * w)
        P["R_wpitch"] = P0.get("R_wpitch", 0.0) + 0.6 * tremor * math.sin(10.0 * w + 1.3)
        P["R_roll"] = P0.get("R_roll", 0.0) + 4.0 * math.sin(w)
        P["L_curl"] = P0.get("L_curl", 0.0) + 0.6 * press * math.sin(2.0 * w)
        P["sp_pitch"] = P0["sp_pitch"] + 0.7 * math.sin(w)
        P["pel_z"] = P0["pel_z"] + 0.003 * math.sin(2.0 * w)
        P["hair_lag"] = P0.get("hair_lag", 0.0) + 0.6 * math.sin(2.0 * w)
        return P
    return fn


def quagmire_hold(P0, period):
    """Pressing: the left palm pushes down twice a second, the fingers flex against the mud, the body presses with it."""
    def fn(t):
        w = TAU * (t % period) / period
        P = dict(P0)
        P["L_lower"] = P0["L_lower"] + 2.5 * math.sin(2.0 * w)
        P["L_elbow"] = P0["L_elbow"] - 2.0 * math.sin(2.0 * w)
        P["L_curl"] = P0["L_curl"] + 5.0 * (1.0 - math.cos(2.0 * w)) * 0.5
        P["L_fan"] = P0.get("L_fan", 0.0) - 3.0 * (1.0 - math.cos(2.0 * w)) * 0.5
        P["sp_pitch"] = P0["sp_pitch"] + 1.0 * math.sin(2.0 * w)
        P["pel_z"] = P0["pel_z"] - 0.006 * math.sin(2.0 * w)
        P["coat_flare"] = P0.get("coat_flare", 0.0) + 1.0 * math.sin(w)
        P["hair_lag"] = P0.get("hair_lag", 0.0) + 0.8 * math.sin(2.0 * w)
        return P
    return fn


